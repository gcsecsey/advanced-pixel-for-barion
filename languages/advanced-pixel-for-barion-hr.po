#. Plugin Name of the plugin
#: advanced-pixel-for-barion.php
msgid "Advanced Pixel for Barion"
msgstr "Barion Pixel za WooCommerce"

#. Plugin URI of the plugin
#: advanced-pixel-for-barion.php
msgid "https://github.com/gcsecsey/advanced-pixel-for-barion"
msgstr ""

#. Description of the plugin
#: advanced-pixel-for-barion.php
msgid "Barion Pixel integration for WooCommerce with full e-commerce event tracking, cookie consent support, and WP Consent API compatibility."
msgstr "Integracija Barion Pixela za WooCommerce s potpunim praćenjem e-trgovinskih događaja, podrškom za pristanak na kolačiće i kompatibilnošću s WP Consent API-jem."

#. Author of the plugin
#: advanced-pixel-for-barion.php
msgid "Gergely Csecsey"
msgstr ""

#. Author URI of the plugin
#: advanced-pixel-for-barion.php
msgid "https://github.com/gcsecsey"
msgstr ""

#: advanced-pixel-for-barion.php:121
msgid "Barion Pixel Settings"
msgstr "Postavke Barion Pixela"

#: advanced-pixel-for-barion.php:122
msgid "Barion Pixel"
msgstr "Barion Pixel"

#: advanced-pixel-for-barion.php:139
msgid "Barion Pixel Configuration"
msgstr "Konfiguracija Barion Pixela"

#: advanced-pixel-for-barion.php:146
msgid "Pixel ID"
msgstr "Pixel ID"

#: advanced-pixel-for-barion.php:154
msgid "Enable Full Pixel Tracking"
msgstr "Omogući potpuno praćenje Pixelom"

#: advanced-pixel-for-barion.php:162
msgid "Debug Mode"
msgstr "Način rada za otklanjanje pogrešaka"

#: advanced-pixel-for-barion.php:214
msgid "Configure your Barion Pixel integration. The Base Pixel will be loaded on all pages when a Pixel ID is provided. Full tracking includes e-commerce events like product views, add to cart, checkout, and purchase."
msgstr "Konfiguriraj svoju Barion Pixel integraciju. Osnovni Pixel učitat će se na svim stranicama kada je naveden Pixel ID. Potpuno praćenje uključuje e-trgovinske događaje kao što su pregledi proizvoda, dodavanje u košaricu, naplata i kupnja."

#: advanced-pixel-for-barion.php:231
msgid "Enter your Barion Pixel ID (e.g., BP-0000000000-00)"
msgstr "Unesi svoj Barion Pixel ID (npr. BP-0000000000-00)"

#: advanced-pixel-for-barion.php:248
msgid "Enable full Barion Pixel event tracking (contentView, addToCart, initiateCheckout, purchase)"
msgstr "Omogući potpuno praćenje događaja Barion Pixelom (contentView, addToCart, initiateCheckout, purchase)"

#: advanced-pixel-for-barion.php:250
msgid "Base Pixel script will always be loaded. Enable this to track e-commerce events."
msgstr "Skripta osnovnog Pixela uvijek će se učitati. Omogući ovo za praćenje e-trgovinskih događaja."

#: advanced-pixel-for-barion.php:267
msgid "Enable debug mode (logs events to browser console)"
msgstr "Omogući način rada za otklanjanje pogrešaka (zapisuje događaje u konzolu preglednika)"

#: advanced-pixel-for-barion.php:708
msgid "Advanced Pixel for Barion: The Barion Payment Gateway plugin also has a Pixel ID configured. Both plugins will work correctly together — the base pixel script will only be loaded once. You may remove the Pixel ID from the payment gateway settings to keep configuration in one place."
msgstr "Barion Pixel za WooCommerce: Dodatak Barion Payment Gateway također ima konfiguriran Pixel ID. Oba dodatka radit će ispravno zajedno — skripta osnovnog Pixela učitat će se samo jednom. Možeš ukloniti Pixel ID iz postavki platnog pristupnika kako bi konfiguraciju držao na jednom mjestu."
