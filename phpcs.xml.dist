<?xml version="1.0"?>
<ruleset name="Advanced Pixel for Barion">
	<description>Coding standards for the Advanced Pixel for Barion plugin.</description>

	<file>.</file>
	<!-- tests/ stubs core WordPress functions on purpose; the CI PHP matrix runs them instead. -->
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tools/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!-- The main plugin file must keep the plugin slug as its name. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<!-- Single-file plugin: the class and its bootstrap functions share one file. -->
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
	</rule>

	<config name="minimum_wp_version" value="5.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="advanced-pixel-for-barion"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wc_barion_pixel"/>
			</property>
		</properties>
	</rule>

	<!-- PHP cross-version compatibility for the supported range (Requires PHP: 7.4). -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
